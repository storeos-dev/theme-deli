<header
  x-data="{ menuOpen: false, searchOpen: false }"
  x-effect="document.body.classList.toggle('overflow-hidden', menuOpen && !$store.cart.open)"
  @keydown.escape.window="menuOpen = false; searchOpen = false"
>
  <div class="page-width relative mx-auto flex items-center gap-3 px-5 py-4 md:gap-6">
    <button
      type="button"
      class="inline-flex size-10 shrink-0 items-center justify-center rounded-sm text-ritual-fg md:hidden"
      @click="menuOpen = true; searchOpen = false"
      :aria-expanded="menuOpen.toString()"
      aria-controls="ritual-mobile-menu"
      aria-label="{{ 'general.menu' | t }}"
    >
      <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <a
      class="sf-subhead absolute left-1/2 -translate-x-1/2 font-heading tracking-[0.12em] uppercase md:static md:left-auto md:translate-x-0 md:shrink-0"
      href="/"
    >
      {% if shop.logo %}
        <img class="h-9 w-auto" src="{{ shop.logo | image_url }}" alt="{{ shop.name }}">
      {% else %}
        {{ shop.name }}
      {% endif %}
    </a>

    <nav class="hidden min-w-0 flex-1 items-center gap-6 md:flex" aria-label="{{ 'general.main_nav' | t }}">
      {% if props.links.size > 0 %}
        {% for link in props.links %}
          <a class="text-sm tracking-wide text-ritual-fg hover:text-ritual-muted" href="{{ link.href }}">{{ link.label }}</a>
        {% endfor %}
      {% else %}
        <a class="text-sm tracking-wide text-ritual-fg hover:text-ritual-muted" href="/collections/all">{{ 'general.shop_all' | t }}</a>
        {% for collection in collections limit: props.menuCollections %}
          <a class="text-sm tracking-wide text-ritual-fg hover:text-ritual-muted" href="{{ collection.url }}">{{ collection.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1">
      {% if props.showSearch %}
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center rounded-sm text-ritual-fg"
          @click="searchOpen = !searchOpen; menuOpen = false; if (searchOpen) $nextTick(() => $refs.searchInput?.focus())"
          :aria-expanded="searchOpen.toString()"
          aria-controls="ritual-search"
          aria-label="{{ 'search.title' | t }}"
        >
          <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5"/>
            <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      {% endif %}

      {% if props.showAccount %}
        <a
          class="hidden size-10 items-center justify-center rounded-sm text-ritual-fg sm:inline-flex"
          href="/account"
          aria-label="{{ 'general.account' | t }}"
        >
          <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="7" r="3.25" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 16.5c1.6-2.6 3.6-3.75 6-3.75s4.4 1.15 6 3.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      {% endif %}

      {% if props.showCart %}
        <button
          type="button"
          class="relative inline-flex size-10 items-center justify-center rounded-sm text-ritual-fg"
          @click="searchOpen = false; menuOpen = false; $store.cart.setOpen(true)"
          :aria-expanded="$store.cart.open.toString()"
          aria-controls="ritual-cart-drawer"
          aria-label="{{ 'general.cart' | t }}"
        >
          <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 6.5h10l-.7 8.2a1.5 1.5 0 0 1-1.5 1.3H7.2a1.5 1.5 0 0 1-1.5-1.3L5 6.5Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7.5 6.5V5a2.5 2.5 0 0 1 5 0v1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span
            class="absolute -right-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-ritual-primary px-1 text-[10px] font-medium text-ritual-bg"
            x-show="$store.cart.totalItems > 0"
            x-text="$store.cart.totalItems"
            x-cloak
          ></span>
        </button>
      {% endif %}
    </div>
  </div>

  {% if props.showSearch %}
    <div
      id="ritual-search"
      class="border-t border-ritual-border bg-ritual-bg"
      x-show="searchOpen"
      x-cloak
      x-transition
    >
      <form class="page-width mx-auto flex items-center gap-3 px-5 py-4" action="/search" method="get" role="search">
        <label class="sr-only" for="ritual-search-input">{{ 'search.title' | t }}</label>
        <input
          id="ritual-search-input"
          class="min-w-0 flex-1 border-0 bg-transparent text-base text-ritual-fg outline-none placeholder:text-ritual-muted"
          type="search"
          name="q"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
          x-ref="searchInput"
        >
        <button class="text-sm font-medium tracking-wide" type="submit">{{ 'search.submit' | t }}</button>
        <button
          class="inline-flex size-10 items-center justify-center text-ritual-muted"
          type="button"
          @click="searchOpen = false"
          aria-label="{{ 'general.close' | t }}"
        >
          <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </form>
    </div>
  {% endif %}

  <div
    id="ritual-mobile-menu"
    class="fixed inset-0 z-40 md:hidden"
    x-show="menuOpen"
    x-cloak
  >
    <button
      type="button"
      class="absolute inset-0 bg-black/30"
      @click="menuOpen = false"
      aria-label="{{ 'general.close' | t }}"
    ></button>
    <nav
      class="absolute inset-y-0 left-0 flex w-[min(100%,20rem)] flex-col gap-1 overflow-y-auto bg-ritual-bg p-6 shadow-xl"
      aria-label="{{ 'general.main_nav' | t }}"
      @click.outside="menuOpen = false"
      x-show="menuOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="-translate-x-full"
      x-transition:enter-end="translate-x-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0"
      x-transition:leave-end="-translate-x-full"
    >
      <div class="mb-4 flex items-center justify-between">
        <span class="text-sm font-medium tracking-wide uppercase">{{ 'general.menu' | t }}</span>
        <button
          type="button"
          class="inline-flex size-10 items-center justify-center text-ritual-muted"
          @click="menuOpen = false"
          aria-label="{{ 'general.close' | t }}"
        >
          <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      {% if props.links.size > 0 %}
        {% for link in props.links %}
          <a class="border-b border-ritual-border py-3 text-base" href="{{ link.href }}">{{ link.label }}</a>
        {% endfor %}
      {% else %}
        <a class="border-b border-ritual-border py-3 text-base" href="/collections/all">{{ 'general.shop_all' | t }}</a>
        {% for collection in collections limit: props.menuCollections %}
          <a class="border-b border-ritual-border py-3 text-base" href="{{ collection.url }}">{{ collection.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>
  </div>

  {% if props.showCart %}
    <div id="ritual-cart-drawer">
      {% render 'cart-drawer' %}
    </div>
  {% endif %}
</header>

{% schema %}
{
  "label": "Header",
  "group": "header",
  "icon": "panel-top",
  "regions": ["chrome.top"],
  "settings": {
    "links": {
      "kind": "link-list",
      "label": "Navigation",
      "default": [
        { "label": "Shop all", "href": "/collections/all" }
      ]
    },
    "menuCollections": {
      "kind": "number",
      "label": "Collections in menu",
      "hint": "Used when Navigation is empty.",
      "min": 0,
      "max": 8,
      "default": 4
    },
    "showSearch": { "kind": "boolean", "label": "Show search", "default": true },
    "showAccount": { "kind": "boolean", "label": "Show account", "default": true },
    "showCart": { "kind": "boolean", "label": "Show cart", "default": true }
  }
}
{% endschema %}
