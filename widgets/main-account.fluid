<section class="page-width mx-auto px-4 py-8 md:py-12" x-data>
  <div class="grid gap-6 lg:grid-cols-[16rem_1fr]">
    {% render 'account-nav', active: 'account' %}

    <div class="min-w-0 space-y-6" x-data="deliOrders({ limit: 3 })">
      <div class="relative overflow-hidden rounded-box bg-ritual-soft p-6 md:p-8">
        <div class="pointer-events-none absolute -right-12 -top-12 size-44 rounded-full bg-ritual-primary/25" aria-hidden="true"></div>
        <p class="relative text-sm font-semibold uppercase tracking-wide text-ritual-accent">{{ 'account.title' | t }}</p>
        <h1 class="relative mt-1 font-heading text-2xl font-bold md:text-3xl">
          {{ props.greeting }}<span x-show="$store.customer.firstName">, <span x-text="$store.customer.firstName"></span></span>!
        </h1>
        <p class="relative mt-1 text-ritual-muted">{{ props.text }}</p>
      </div>

      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        <a class="rounded-box border border-ritual-border bg-ritual-bg p-4 hover:border-ritual-primary" href="/account/orders">
          <p class="text-2xl font-bold text-ritual-accent" x-text="loading ? '–' : total">–</p>
          <p class="mt-1 text-sm text-ritual-muted">{{ 'account.orders' | t }}</p>
        </a>
        <a class="rounded-box border border-ritual-border bg-ritual-bg p-4 hover:border-ritual-primary" href="/wishlist">
          <p class="text-2xl font-bold text-ritual-accent" x-text="$store.wishlist.ids.length">0</p>
          <p class="mt-1 text-sm text-ritual-muted">{{ 'account.wishlist' | t }}</p>
        </a>
        <a class="rounded-box border border-ritual-border bg-ritual-bg p-4 hover:border-ritual-primary" href="/cart">
          <p class="text-2xl font-bold text-ritual-accent" x-text="$store.cart.totalItems">0</p>
          <p class="mt-1 text-sm text-ritual-muted">{{ 'account.in_bag' | t }}</p>
        </a>
        <a class="rounded-box border border-ritual-border bg-ritual-bg p-4 hover:border-ritual-primary" href="/account/profile">
          <p class="truncate text-sm font-semibold" x-text="$store.customer.user?.phoneNumber || '—'">—</p>
          <p class="mt-1 text-sm text-ritual-muted">{{ 'account.profile' | t }}</p>
        </a>
      </div>

      <div>
        <div class="mb-3 flex items-center justify-between">
          <h2 class="font-heading text-lg font-semibold">{{ 'account.recent_orders' | t }}</h2>
          <a class="text-sm font-semibold text-ritual-accent hover:underline" href="/account/orders">{{ 'general.view_all' | t }} →</a>
        </div>
        <div class="rounded-box border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert" x-show="error" x-text="error" x-cloak></div>
        <div class="space-y-3" x-show="loading">
          <div class="h-32 animate-pulse rounded-box bg-ritual-soft"></div>
        </div>
        <div class="space-y-3" x-show="!loading" x-cloak>
          <template x-for="order in orders" :key="order._id">
            {% render 'order-card' %}
          </template>
          <div class="rounded-box border border-dashed border-ritual-border p-8 text-center" x-show="!error && orders.length === 0">
            <p class="font-semibold">{{ 'account.no_orders' | t }}</p>
            <a class="mt-3 inline-flex h-10 items-center rounded-box bg-ritual-primary px-5 text-sm font-semibold text-ritual-on-primary" href="/collections/all">{{ 'general.shop_now' | t }}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "label": "Account overview",
  "group": "page",
  "icon": "user",
  "regions": ["pages.account"],
  "settings": {
    "greeting": { "kind": "text", "default": "Hello" },
    "text": { "kind": "text", "default": "Your orders, saved items and details in one place." }
  }
}
{% endschema %}
