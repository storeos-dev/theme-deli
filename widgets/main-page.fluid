<section class="page-width mx-auto px-4 py-8 md:py-12">
  <article class="mx-auto max-w-3xl">
    <nav class="mb-4 text-sm text-ritual-muted" aria-label="Breadcrumb">
      <a class="hover:text-ritual-accent" href="/">{{ 'general.home' | t }}</a>
      <span class="mx-2">/</span>
      <span class="text-ritual-fg">{{ page.title }}</span>
    </nav>
    <h1 class="font-heading text-3xl font-bold leading-tight md:text-4xl">{{ page.title }}</h1>
    {% assign page_image = page.image | image_url %}
    {% if page_image != blank and props.showImage %}
      <img class="mt-6 aspect-[16/7] w-full rounded-box object-cover" src="{{ page_image }}" alt="{{ page.title }}">
    {% endif %}
    <div class="deli-prose mt-6">{{ page.content }}</div>
  </article>
</section>

{% schema %}
{
  "label": "Page content",
  "group": "page",
  "icon": "file-text",
  "regions": ["pages.page"],
  "settings": {
    "showImage": { "kind": "boolean", "label": "Show page image", "default": true }
  }
}
{% endschema %}
