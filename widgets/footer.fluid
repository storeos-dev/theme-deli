<footer>
  <div class="page-width mx-auto grid grid-cols-2 gap-x-6 gap-y-10 px-4 py-10 md:py-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] container">
    <div class="col-span-2 lg:col-span-1">
      <a class="inline-block" href="/" aria-label="{{ shop.name }}">
        {% if props.useStoreLogo and shop.logo %}
          <img class="h-14 w-auto" src="{{ shop.logo | image_url }}" alt="{{ shop.name }}">
        {% else %}
          <img class="h-16 w-auto" src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="88" height="64">
        {% endif %}
      </a>
      {% if props.tagline != blank %}
        <p class="mt-4 text-lg font-semibold">{{ props.tagline }}</p>
      {% endif %}
      <ul class="mt-3 space-y-1.5 text-sm text-ritual-muted">
        {% if props.phone != blank %}<li>{{ 'general.call_us' | t }}: <a class="font-medium text-ritual-fg hover:text-ritual-accent" href="tel:{{ props.phone }}">{{ props.phone }}</a></li>{% endif %}
        {% if props.email != blank %}<li>{{ 'general.email' | t }}: <a class="font-medium text-ritual-fg hover:text-ritual-accent" href="mailto:{{ props.email }}">{{ props.email }}</a></li>{% endif %}
        {% if props.address != blank %}<li>{{ props.address }}</li>{% endif %}
      </ul>
    </div>

    {% for column in props.columns %}
      <div>
        {% if column.title != blank %}
          <h2 class="mb-4 text-base font-semibold">{{ column.title }}</h2>
        {% endif %}
        <ul class="space-y-2.5">
          {% for link in column.links %}
            <li><a class="text-sm text-ritual-muted hover:text-ritual-accent" href="{{ link.href }}">{{ link.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    {% endfor %}

    <div class="col-span-2 lg:col-span-1">
      {% if props.paymentMethods.size > 0 %}
        <h2 class="mb-4 text-base font-semibold">{{ props.paymentHeading | default: 'Pay with' }}</h2>
        <ul class="flex flex-wrap gap-2">
          {% for method in props.paymentMethods %}
            <li class="rounded-box border border-ritual-border bg-ritual-bg px-2.5 py-1 text-xs font-semibold text-ritual-muted">{{ method }}</li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if props.socialLinks.size > 0 %}
        <h2 class="mb-3 mt-6 text-base font-semibold">{{ 'general.follow_us' | t }}</h2>
        <ul class="flex flex-wrap gap-2">
          {% for link in props.socialLinks %}
            {% assign social = link.href | append: ' ' | append: link.label | downcase %}
            {% if social contains 'facebook' or social contains 'fb.com' %}
              {% assign social_bg = 'bg-[#1877F2]' %}
            {% elsif social contains 'youtube' or social contains 'youtu.be' %}
              {% assign social_bg = 'bg-[#FF0000]' %}
            {% elsif social contains 'instagram' %}
              {% assign social_bg = 'bg-gradient-to-tr from-[#FEDA75] via-[#D62976] to-[#4F5BD5]' %}
            {% elsif social contains 'tiktok' %}
              {% assign social_bg = 'bg-black' %}
            {% elsif social contains 'twitter' or social contains 'x.com' %}
              {% assign social_bg = 'bg-black' %}
            {% elsif social contains 'linkedin' %}
              {% assign social_bg = 'bg-[#0A66C2]' %}
            {% elsif social contains 'whatsapp' or social contains 'wa.me' %}
              {% assign social_bg = 'bg-[#25D366]' %}
            {% else %}
              {% assign social_bg = 'bg-ritual-primary' %}
            {% endif %}
            <li>
              <a
                class="inline-flex size-9 items-center justify-center rounded-box text-white transition hover:-translate-y-0.5 hover:shadow-md {{ social_bg }}"
                href="{{ link.href }}"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="{{ link.label }}"
                title="{{ link.label }}"
              >
                {% if social contains 'facebook' or social contains 'fb.com' %}
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg>
                {% elsif social contains 'youtube' or social contains 'youtu.be' %}
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3L10 15Z"/></svg>
                {% elsif social contains 'instagram' %}
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
                {% elsif social contains 'tiktok' %}
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 3c.3 2.3 1.7 3.8 3.9 4v3.1a7.6 7.6 0 0 1-3.9-1.2v6.3a5.9 5.9 0 1 1-5.9-5.9h.5v3.2h-.5a2.7 2.7 0 1 0 2.7 2.7V3h3.2Z"/></svg>
                {% elsif social contains 'twitter' or social contains 'x.com' %}
                  <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L2 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z"/></svg>
                {% elsif social contains 'linkedin' %}
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.3 9h3.4v11.5H3.3V9Zm5.6 0h3.3v1.6c.5-.9 1.6-1.8 3.3-1.8 3.5 0 4.2 2.3 4.2 5.3v6.4h-3.4v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3v5.8H8.9V9Z"/></svg>
                {% elsif social contains 'whatsapp' or social contains 'wa.me' %}
                  <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.5 21.5l4.8-1.3A9.5 9.5 0 1 0 12 2.5Zm0 17.3c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A7.8 7.8 0 1 1 12 19.8Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6.5-.1 1.4-.6 1.6-1.2.2-.6.2-1 .1-1.2l-.4-.3Z"/></svg>
                {% else %}
                  <span class="text-sm font-bold uppercase">{{ link.label | slice: 0 }}</span>
                {% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>

  <div class="bg-ritual-primary text-ritual-on-primary">
    <div class="page-width mx-auto flex flex-col items-center gap-1 px-4 py-4 text-sm sm:flex-row sm:justify-between">
      <p>Copyright &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      {% if props.showPoweredBy %}
        <p>{{ 'general.powered_by' | t }}</p>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "label": "Footer",
  "group": "footer",
  "icon": "panel-bottom",
  "regions": ["chrome.bottom"],
  "settings": {
    "useStoreLogo": {
      "kind": "boolean",
      "label": "Use store logo",
      "hint": "Off shows the deli logo from the theme. On uses the logo from your store settings.",
      "default": false
    },
    "tagline": { "kind": "text", "label": "Tagline", "default": "Always here for you" },
    "phone": { "kind": "text", "label": "Phone", "default": "16469" },
    "email": { "kind": "text", "label": "Email", "default": "" },
    "address": { "kind": "textarea", "label": "Address", "default": "" },
    "columns": {
      "kind": "footer-columns",
      "label": "Link columns",
      "default": [
        {
          "title": "Information",
          "links": [
            { "label": "About us", "href": "/pages/about" },
            { "label": "Shipping & returns", "href": "/pages/shipping-policy" },
            { "label": "Terms & conditions", "href": "/pages/terms" }
          ]
        },
        {
          "title": "Customer service",
          "links": [
            { "label": "Contact us", "href": "/pages/contact" },
            { "label": "My account", "href": "/account" },
            { "label": "Shop all", "href": "/collections/all" }
          ]
        }
      ]
    },
    "paymentHeading": { "kind": "text", "label": "Payments heading", "default": "Pay with" },
    "paymentMethods": {
      "kind": "string-list",
      "label": "Payment methods",
      "default": ["Cash on delivery", "bKash", "Nagad", "VISA", "Mastercard"]
    },
    "socialLinks": {
      "kind": "link-list",
      "label": "Social links",
      "default": [
        { "label": "Facebook", "href": "https://facebook.com" },
        { "label": "YouTube", "href": "https://youtube.com" },
        { "label": "Instagram", "href": "https://instagram.com" }
      ]
    },
    "showPoweredBy": {
      "kind": "boolean",
      "label": "Show “Powered by StoreOS”",
      "default": true
    }
  }
}
{% endschema %}
