<section class="page-width mx-auto px-5 py-12 md:py-16">
  {% if props.heading != blank %}
    <h2 class="sf-heading mb-10 text-center">{{ props.heading }}</h2>
  {% endif %}

  {% if props.columns.size > 0 %}
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {% for column in props.columns %}
        <div class="flex flex-col gap-3 text-center">
          {% if column.icon != blank %}
            <div class="rounded-box mx-auto flex size-10 items-center justify-center border border-ritual-border text-ritual-fg" aria-hidden="true">
              <span class="text-lg leading-none">{{ column.icon }}</span>
            </div>
          {% endif %}
          {% if column.title != blank %}
            <h3 class="sf-subhead text-base tracking-normal normal-case">{{ column.title }}</h3>
          {% endif %}
          {% if column.text != blank %}
            <p class="sf-body text-sm text-ritual-muted">{{ column.text }}</p>
          {% endif %}
          {% if column.href != blank %}
            <a class="sf-caption mt-1 uppercase tracking-wide text-ritual-fg hover:text-ritual-muted" href="{{ column.href }}">
              {{ 'general.learn_more' | t }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "label": "Multicolumn",
  "group": "page",
  "icon": "columns-3",
  "settings": {
    "heading": { "kind": "text", "default": "Why ritual" },
    "columns": {
      "kind": "icon-box-list",
      "label": "Columns",
      "default": [
        {
          "icon": "◇",
          "title": "Thoughtful materials",
          "text": "Chosen for feel and longevity, not trends."
        },
        {
          "icon": "○",
          "title": "Quiet design",
          "text": "Clean lines that sit easily in everyday spaces."
        },
        {
          "icon": "△",
          "title": "Made to last",
          "text": "Fewer pieces, better made — season after season."
        }
      ]
    }
  }
}
{% endschema %}
