{% assign featured = product.featured_image %}
{% assign initial_price = product.price | money %}
{% assign initial_compare = '' %}
{% if product.compare_at_price and product.compare_at_price > product.price %}
  {% assign initial_compare = product.compare_at_price | money %}
{% endif %}

<section
  class="page-width mx-auto px-5 py-10 md:py-14"
  data-product
  x-data="ProductData"
>
  <script type="application/json" data-product>
    {
      "image": {{ featured | image_url | json | raw }},
      "price": {{ initial_price | json | raw }},
      "compare": {{ initial_compare | json | raw }},
      "unitPrice": {{ product.price | default: 0 }},
      "variantId": {% if product.variants.first %}{{ product.variants.first.id | json | raw }}{% else %}null{% endif %},
      "variantTitle": {% if product.variants.first %}{{ product.variants.first.title | json | raw }}{% else %}""{% endif %},
      "available": {{ product.available }},
      "productId": {{ product.id | json | raw }},
      "title": {{ product.title | json | raw }},
      "labels": {
        "soldOut": {{ 'products.sold_out' | t | json | raw }},
        "added": {{ 'products.added' | t | json | raw }},
        "addToCart": {{ 'products.add_to_cart' | t | json | raw }},
        "buyNow": {{ 'products.buy_now' | t | json | raw }}
      }
    }
  </script>

  <div class="grid gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
    <div class="min-w-0">
      <div class="rounded-box aspect-square overflow-hidden bg-ritual-border/30">
        {% if featured %}
          <img
            class="h-full w-full object-cover"
            src="{{ featured | image_url }}"
            :src="image"
            alt="{{ product.title | escape }}"
            width="800"
            height="800"
          >
        {% else %}
          <div class="flex h-full w-full items-center justify-center text-sm text-ritual-muted">
            {{ product.title }}
          </div>
        {% endif %}
      </div>

      {% if props.showThumbnails and product.images.size > 1 %}
        <ul class="mt-3 flex gap-2 overflow-x-auto pb-1" role="list">
          {% for image in product.images %}
            <li class="shrink-0">
              <button
                type="button"
                class="rounded-box block size-16 overflow-hidden border border-ritual-border bg-ritual-bg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ritual-fg"
                :class="image === '{{ image | image_url }}' ? 'border-ritual-fg' : 'hover:border-ritual-muted'"
                @click="image = '{{ image | image_url }}'"
                aria-label="{{ image.alt | default: product.title | escape }}"
              >
                <img
                  class="size-full object-cover"
                  src="{{ image | image_url }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  width="64"
                  height="64"
                  loading="lazy"
                >
              </button>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="flex min-w-0 flex-col md:sticky md:top-24 md:self-start">
      {% if props.showCollection and product.collections.size > 0 %}
        <a
          class="sf-caption mb-3 uppercase tracking-wide text-ritual-muted hover:text-ritual-fg"
          href="{{ product.collections.first.url }}"
        >{{ product.collections.first.title }}</a>
      {% endif %}

      <h1 class="sf-heading">{{ product.title }}</h1>

      <div class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-0.5 text-base">
        <span class="font-medium text-ritual-fg" x-text="price"></span>
        <s
          class="text-ritual-muted"
          x-show="compare"
          x-text="compare"
          x-cloak
        ></s>
      </div>

      {% unless product.has_only_default_variant %}
        <label class="mt-8 block">
          <span class="sf-caption mb-2 block uppercase tracking-wide text-ritual-muted">
            {{ product.options | map: 'name' | join: ' / ' }}
          </span>
          <select
            class="rounded-box w-full border border-ritual-border bg-ritual-bg px-3 py-2.5 text-sm text-ritual-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ritual-fg"
            data-variant-select
            @change="pickVariant($event.target)"
          >
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-unit-price="{{ variant.price }}"
                data-title="{{ variant.title | escape }}"
                data-compare="{% if variant.compare_at_price and variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                data-available="{% if variant.available %}true{% else %}false{% endif %}"
                {% unless variant.available %}disabled{% endunless %}
                {% if forloop.first %}selected{% endif %}
              >
                {{ variant.title }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}
              </option>
            {% endfor %}
          </select>
        </label>
      {% endunless %}

      {% if props.showQuantity %}
        <div class="mt-6">
          <p class="sf-caption mb-2 uppercase tracking-wide text-ritual-muted">{{ 'products.quantity' | t }}</p>
          <div class="rounded-box inline-flex h-11 items-center border border-ritual-border bg-ritual-bg">
            <button
              type="button"
              class="inline-flex size-11 items-center justify-center text-ritual-muted disabled:opacity-40"
              :disabled="!available || quantity <= 1"
              @click="setQuantity(quantity - 1)"
              aria-label="{{ 'cart.decrease' | t }}"
            >−</button>
            <input
              class="w-10 border-0 bg-transparent text-center text-sm font-medium tabular-nums text-ritual-fg outline-none"
              type="number"
              name="quantity"
              min="1"
              max="99"
              inputmode="numeric"
              :value="quantity"
              @change="setQuantity($event.target.value)"
            >
            <button
              type="button"
              class="inline-flex size-11 items-center justify-center text-ritual-muted disabled:opacity-40"
              :disabled="!available || quantity >= 99"
              @click="setQuantity(quantity + 1)"
              aria-label="{{ 'cart.increase' | t }}"
            >+</button>
          </div>
        </div>
      {% endif %}

      <div class="mt-8 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        <button
          class="rounded-box inline-flex h-11 items-center justify-center gap-2 border border-ritual-border bg-ritual-bg px-4 text-sm font-semibold text-ritual-fg transition-colors duration-200 enabled:hover:border-ritual-fg disabled:cursor-not-allowed disabled:opacity-40"
          type="button"
          data-add-to-cart
          :disabled="!available"
          @click="addToCart()"
        >
          <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 6.5h10l-.7 8.2a1.5 1.5 0 0 1-1.5 1.3H7.2a1.5 1.5 0 0 1-1.5-1.3L5 6.5Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7.5 6.5V5a2.5 2.5 0 0 1 5 0v1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span x-text="addLabel"></span>
        </button>
        {% if props.showBuyNow %}
          <button
            class="rounded-box inline-flex h-11 items-center justify-center gap-2 bg-ritual-primary px-4 text-sm font-semibold text-ritual-on-primary transition-colors duration-200 enabled:hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
            type="button"
            data-buy-now
            :disabled="!available"
            @click="buyNow()"
          >
            <svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10.5h8.5M10 6.5l4.5 4-4.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span x-text="available ? labels.buyNow : labels.soldOut"></span>
          </button>
        {% endif %}
      </div>

      {% if props.showDescription and product.description != blank %}
        <div class="sf-body mt-10 space-y-3 border-t border-ritual-border pt-8 text-ritual-muted [&_a]:underline [&_p+p]:mt-3">
          {{ product.description }}
        </div>
      {% endif %}
    </div>
  </div>

  {% if props.showSpecs and product.technical_specs.size > 0 %}
    <div class="mt-14 border-t border-ritual-border pt-10 md:mt-16">
      <h2 class="sf-heading text-xl">{{ 'products.specifications' | t }}</h2>
      <table class="mt-6 w-full max-w-2xl text-left text-sm">
        <tbody class="divide-y divide-ritual-border">
          {% for spec in product.technical_specs %}
            <tr>
              <th class="w-1/3 py-3 pr-4 font-medium text-ritual-fg" scope="row">{{ spec.key }}</th>
              <td class="py-3 text-ritual-muted">
                {{ spec.value }}{% if spec.unit != blank %} {{ spec.unit }}{% endif %}
                {% if spec.notes != blank %}
                  <div class="mt-1 text-xs">{{ spec.notes }}</div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if props.showInformationSections and product.information_sections.size > 0 %}
    <div class="mt-10 max-w-2xl space-y-2 border-t border-ritual-border pt-10">
      {% for info in product.information_sections %}
        <details class="group border-b border-ritual-border" {% if forloop.first %}open{% endif %}>
          <summary class="cursor-pointer list-none py-4 font-medium text-ritual-fg marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {{ info.title }}
              <span class="text-ritual-muted transition group-open:rotate-45" aria-hidden="true">+</span>
            </span>
          </summary>
          <div class="sf-body pb-5 text-ritual-muted [&_a]:underline [&_p+p]:mt-3">
            {{ info.content }}
          </div>
        </details>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "label": "Product information",
  "group": "page",
  "icon": "package",
  "regions": ["pages.product"],
  "defaultProps": {
    "showThumbnails": true,
    "showCollection": true,
    "showQuantity": true,
    "showBuyNow": true,
    "showDescription": true,
    "showSpecs": true,
    "showInformationSections": true
  },
  "settings": {
    "showThumbnails": {
      "kind": "boolean",
      "label": "Show image thumbnails",
      "default": true
    },
    "showCollection": {
      "kind": "boolean",
      "label": "Show collection link",
      "default": true
    },
    "showQuantity": {
      "kind": "boolean",
      "label": "Show quantity",
      "default": true
    },
    "showBuyNow": {
      "kind": "boolean",
      "label": "Show buy now",
      "default": true
    },
    "showDescription": {
      "kind": "boolean",
      "label": "Show description",
      "default": true
    },
    "showSpecs": {
      "kind": "boolean",
      "label": "Show specifications",
      "default": true
    },
    "showInformationSections": {
      "kind": "boolean",
      "label": "Show information sections",
      "default": true
    }
  }
}
{% endschema %}
