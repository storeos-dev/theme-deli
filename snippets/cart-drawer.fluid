<div
  class="fixed inset-0 z-50"
  x-show="$store.cart.open"
  x-cloak
  @keydown.escape.window="$store.cart.setOpen(false)"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ritual-cart-title"
>
  <button
    type="button"
    class="absolute inset-0 bg-black/30"
    @click="$store.cart.setOpen(false)"
    aria-label="{{ 'general.close' | t }}"
  ></button>

  <aside
    class="absolute inset-y-0 right-0 flex w-full max-w-md flex-col bg-ritual-bg text-ritual-fg shadow-xl"
    @click.outside="$store.cart.setOpen(false)"
    x-show="$store.cart.open"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
  >
    <header class="flex items-center justify-between gap-3 border-b border-ritual-border px-5 py-4">
      <h2 id="ritual-cart-title" class="flex items-center gap-2 text-lg font-medium">
        <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 6.5h10l-.7 8.2a1.5 1.5 0 0 1-1.5 1.3H7.2a1.5 1.5 0 0 1-1.5-1.3L5 6.5Z" stroke="currentColor" stroke-width="1.5"/>
          <path d="M7.5 6.5V5a2.5 2.5 0 0 1 5 0v1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>{{ 'cart.title' | t }}</span>
        <span
          class="inline-flex size-5 items-center justify-center rounded-full bg-ritual-primary text-[11px] font-medium text-ritual-on-primary"
          x-show="$store.cart.totalItems > 0"
          x-text="$store.cart.totalItems"
          x-cloak
        ></span>
      </h2>
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center text-ritual-muted hover:text-ritual-fg"
        @click="$store.cart.setOpen(false)"
        aria-label="{{ 'general.close' | t }}"
      >
        <svg class="size-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto">
      <template x-if="$store.cart.ready && $store.cart.lineItems.length === 0">
        <p class="px-5 py-8 text-sm text-ritual-muted">{{ 'cart.empty' | t }}</p>
      </template>

      <ul class="divide-y divide-ritual-border">
        <template x-for="item in $store.cart.lineItems" :key="$store.cart.lineKey(item)">
          <li class="flex gap-3 px-5 py-4">
            <div class="rounded-box size-16 shrink-0 overflow-hidden bg-ritual-border/40">
              <img
                class="size-full object-cover"
                :src="$store.cart.imageUrl(item)"
                alt=""
                width="64"
                height="64"
                x-show="$store.cart.imageUrl(item)"
              >
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="truncate text-sm font-medium" x-text="item.product.name"></p>
                  <p
                    class="mt-0.5 text-sm text-ritual-muted"
                    x-show="item.product.variantName"
                    x-text="item.product.variantName"
                    x-cloak
                  ></p>
                  <p
                    class="mt-0.5 text-sm text-ritual-muted"
                    x-text="$store.cart.formatMoney(item.product.unitPrice)"
                  ></p>
                </div>
                <button
                  type="button"
                  class="shrink-0 text-ritual-muted hover:text-ritual-fg"
                  @click="$store.cart.removeItem(item.productId, item.variantId, item.offerId)"
                  :aria-label="'{{ 'cart.remove' | t }} ' + item.product.name"
                >
                  <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>

              <div class="mt-3 flex items-center justify-between gap-3" x-show="!item.offerId">
                <div class="rounded-box inline-flex items-center border border-ritual-border">
                  <button
                    type="button"
                    class="inline-flex size-8 items-center justify-center text-ritual-fg"
                    @click="$store.cart.adjustQuantity(item.productId, item.quantity - 1, item.variantId, item.offerId)"
                    aria-label="{{ 'cart.decrease' | t }}"
                  >−</button>
                  <span class="min-w-8 text-center text-sm" x-text="item.quantity"></span>
                  <button
                    type="button"
                    class="inline-flex size-8 items-center justify-center text-ritual-fg"
                    @click="$store.cart.adjustQuantity(item.productId, item.quantity + 1, item.variantId, item.offerId)"
                    aria-label="{{ 'cart.increase' | t }}"
                  >+</button>
                </div>
                <p
                  class="text-sm font-medium"
                  x-text="$store.cart.formatMoney(item.product.unitPrice * item.quantity)"
                ></p>
              </div>

              <div class="mt-3 flex items-center justify-between gap-3 text-sm" x-show="item.offerId" x-cloak>
                <span class="text-ritual-muted">{{ 'cart.free' | t }} · Qty <span x-text="item.quantity"></span></span>
                <span class="font-medium">{{ 'cart.free' | t }}</span>
              </div>
            </div>
          </li>
        </template>
      </ul>
    </div>

    <footer class="space-y-3 border-t border-ritual-border px-5 py-4">
      <div class="flex items-center justify-between text-sm">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span class="font-semibold" x-text="$store.cart.formatMoney($store.cart.subTotalAmount)"></span>
      </div>
      <p class="text-xs text-ritual-muted">{{ 'cart.shipping_note' | t }}</p>
      <a
        class="rounded-box flex w-full items-center justify-center bg-ritual-primary px-5 py-3 text-sm font-medium text-ritual-on-primary"
        href="/checkout"
        @click="$store.cart.setOpen(false)"
        x-show="$store.cart.lineItems.length > 0"
      >{{ 'cart.checkout' | t }}</a>
      <a
        class="rounded-box flex w-full items-center justify-center border border-ritual-primary px-5 py-3 text-sm font-semibold text-ritual-accent hover:bg-ritual-soft"
        href="/cart"
        x-show="$store.cart.lineItems.length > 0"
      >{{ 'cart.view_bag' | t }}</a>
      <button
        type="button"
        class="rounded-box flex w-full items-center justify-center border border-ritual-border px-5 py-3 text-sm font-medium text-ritual-fg"
        @click="$store.cart.setOpen(false)"
      >{{ 'cart.continue' | t }}</button>
    </footer>
  </aside>
</div>
