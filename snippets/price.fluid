<span class="inline-flex flex-wrap items-baseline justify-center gap-x-1.5 gap-y-0.5">
  {% if compare_at_price and compare_at_price > price %}
    <s class="text-xs text-ritual-muted">{{ compare_at_price | money }}</s>
  {% endif %}
  <span class="text-base font-semibold text-ritual-accent">{{ price | money }}</span>
</span>
