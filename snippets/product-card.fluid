{% comment %}
  Deli product card — bordered card, discount tag, delivery note,
  price in brand green and an "Add to Bag" pill with a qty stepper.
{% endcomment %}
{% assign card_image = product.featured_image | image_url %}
{% assign has_discount = false %}
{% if product.compare_at_price and product.compare_at_price > product.price %}
  {% assign has_discount = true %}
  {% assign saving = product.compare_at_price | minus: product.price %}
{% endif %}

<article class="group relative flex h-full flex-col rounded-box border border-ritual-border bg-ritual-bg p-3 transition hover:border-ritual-primary hover:shadow-md">
  {% if has_discount %}
    <span class="absolute left-2 top-2 z-10 flex flex-col items-center rounded-box bg-ritual-sale px-1.5 py-1 text-center text-[10px] font-semibold leading-none text-white">
      <span>{{ saving | money }}</span>
      <span class="mt-0.5">{{ 'products.off' | t }}</span>
    </span>
  {% endif %}
  {%- comment -%} Save for later: stored in the shopper's StoreOS account (signed-out shoppers go to sign-in) {%- endcomment -%}
  <button
    type="button"
    class="absolute right-2 top-2 z-10 inline-flex size-8 items-center justify-center rounded-full bg-ritual-bg/90 shadow-sm transition hover:scale-110"
    x-data
    data-id="{{ product.id }}"
    data-title="{{ product.title | escape }}"
    data-handle="{{ product.handle }}"
    data-price="{{ product.price | default: 0 }}"
    data-image="{{ card_image }}"
    :class="$store.wishlist.has($el.dataset.id) ? 'text-ritual-sale' : 'text-ritual-muted hover:text-ritual-sale'"
    :aria-pressed="$store.wishlist.has($el.dataset.id).toString()"
    @click="$store.wishlist.toggle({ _id: $el.dataset.id, title: $el.dataset.title, handle: $el.dataset.handle, price: Number($el.dataset.price), thumbnail: { external: $el.dataset.image } })"
    data-label-save="{{ 'wishlist.save' | t | escape }}"
    data-label-remove="{{ 'wishlist.remove' | t | escape }}"
    data-label-sign-in="{{ 'wishlist.save_signed_out' | t | escape }}"
    aria-label="{{ 'wishlist.save' | t }}"
    :aria-label="!$store.customer.signedIn ? $el.dataset.labelSignIn : $store.wishlist.has($el.dataset.id) ? $el.dataset.labelRemove : $el.dataset.labelSave"
  >
    <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
      <path :fill="$store.wishlist.has($el.closest('button').dataset.id) ? 'currentColor' : 'none'" stroke="currentColor" stroke-width="2" d="M12 20s-7-4.3-8.9-8.6C1.7 8.4 3.6 5 7 5c2 0 3.4 1.1 5 2.8C13.6 6.1 15 5 17 5c3.4 0 5.3 3.4 3.9 6.4C19 15.7 12 20 12 20Z"/>
    </svg>
  </button>

  <a class="block" href="{{ product.url }}">
    <div class="relative aspect-square overflow-hidden rounded-box bg-ritual-bg">
      {% unless product.available %}
        <span class="absolute inset-x-0 bottom-0 z-10 bg-ritual-fg/80 py-1 text-center text-[11px] font-medium text-ritual-bg">
          {{ 'products.sold_out' | t }}
        </span>
      {% endunless %}
      {% if card_image != blank %}
        <img
          class="size-full object-contain p-2 transition duration-300 group-hover:scale-[1.04]"
          src="{{ card_image }}"
          alt="{{ product.featured_image.alt | default: product.title }}"
          loading="lazy"
        >
      {% else %}
        <div class="size-full bg-ritual-soft"></div>
      {% endif %}
    </div>
  </a>

  <div class="mt-3 flex flex-1 flex-col items-center text-center">
    {% if delivery_note != blank %}
      <p class="text-xs italic text-ritual-muted">{{ delivery_note }}</p>
    {% endif %}
    <h3 class="mt-1 line-clamp-2 min-h-[2.5rem] text-sm font-medium leading-5">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="mt-2">
      {% render 'price', price: product.price, compare_at_price: product.compare_at_price %}
    </div>

    <div class="mt-auto w-full pt-3">
      {% if product.available and product.has_only_default_variant %}
        <div
          x-data="deliQuickAdd"
          data-product-id="{{ product.id }}"
          data-variant-id="{{ product.variants.first.id }}"
          data-title="{{ product.title | escape }}"
          data-image="{{ card_image }}"
          data-unit-price="{{ product.price | default: 0 }}"
        >
          <button
            type="button"
            class="inline-flex h-9 w-full items-center justify-center gap-1.5 rounded-box bg-ritual-primary px-4 text-sm font-semibold text-ritual-on-primary transition hover:brightness-95"
            x-show="qty === 0"
            @click="add()"
          >
            <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            {{ 'products.add_to_bag' | t }}
          </button>
          <div
            class="flex h-9 w-full items-center justify-between rounded-box bg-ritual-primary text-ritual-on-primary"
            x-show="qty > 0"
            x-cloak
          >
            <button type="button" class="inline-flex size-9 items-center justify-center text-lg font-semibold" @click="change(-1)" aria-label="{{ 'cart.decrease' | t }}">−</button>
            <span class="text-sm font-semibold"><span x-text="qty"></span> {{ 'products.in_bag' | t }}</span>
            <button type="button" class="inline-flex size-9 items-center justify-center text-lg font-semibold" @click="change(1)" aria-label="{{ 'cart.increase' | t }}">+</button>
          </div>
        </div>
      {% elsif product.available %}
        <a
          class="inline-flex h-9 w-full items-center justify-center rounded-box bg-ritual-primary px-4 text-sm font-semibold text-ritual-on-primary transition hover:brightness-95"
          href="{{ product.url }}"
        >{{ 'products.choose_options' | t }}</a>
      {% else %}
        <span class="inline-flex h-9 w-full items-center justify-center rounded-box border border-ritual-border px-4 text-sm font-medium text-ritual-muted">
          {{ 'products.sold_out' | t }}
        </span>
      {% endif %}
    </div>
  </div>
</article>
