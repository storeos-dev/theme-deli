{% comment %}
  Account sidebar. Pass: active ("account" | "orders" | "profile" | "wishlist" | "track-order").
{% endcomment %}
<aside class="rounded-box border border-ritual-border bg-ritual-bg p-4 lg:sticky lg:top-36 lg:self-start">
  <div class="flex items-center gap-3 border-b border-ritual-border pb-4">
    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-ritual-primary font-heading text-lg font-bold text-ritual-on-primary" x-text="($store.customer.firstName || '?').slice(0, 1).toUpperCase()">?</span>
    <div class="min-w-0">
      <p class="text-xs text-ritual-muted">{{ 'account.hello' | t }}</p>
      <p class="truncate font-semibold" x-text="$store.customer.user?.name || '…'"></p>
    </div>
  </div>
  <nav class="mt-3 flex gap-1 overflow-x-auto lg:flex-col" aria-label="{{ 'account.title' | t }}">
    {% assign nav_items = 'account,orders,profile,wishlist,track-order' | split: ',' %}
    {% for item in nav_items %}
      {% case item %}
        {% when 'account' %}{% assign nav_href = '/account' %}{% assign nav_label = 'account.overview' | t %}
        {% when 'orders' %}{% assign nav_href = '/account/orders' %}{% assign nav_label = 'account.orders' | t %}
        {% when 'profile' %}{% assign nav_href = '/account/profile' %}{% assign nav_label = 'account.profile' | t %}
        {% when 'wishlist' %}{% assign nav_href = '/wishlist' %}{% assign nav_label = 'account.wishlist' | t %}
        {% when 'track-order' %}{% assign nav_href = '/track-order' %}{% assign nav_label = 'account.track' | t %}
      {% endcase %}
      <a
        class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-box px-3 py-2.5 text-sm {% if item == active %}bg-ritual-primary font-semibold text-ritual-on-primary{% else %}hover:bg-ritual-soft hover:text-ritual-accent{% endif %}"
        href="{{ nav_href }}"
        {% if item == active %}aria-current="page"{% endif %}
      >{{ nav_label }}</a>
    {% endfor %}
    <button
      type="button"
      class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-box px-3 py-2.5 text-left text-sm text-ritual-muted hover:bg-ritual-soft hover:text-ritual-sale"
      @click="$store.customer.signOut()"
    >{{ 'account.sign_out' | t }}</button>
  </nav>
</aside>
