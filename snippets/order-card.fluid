{% comment %}
  One order inside an Alpine `x-for="order in orders"` loop of `deliOrders`.
{% endcomment %}
<article class="rounded-box border border-ritual-border bg-ritual-bg p-4 transition hover:border-ritual-primary md:p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="font-semibold">{{ 'account.order' | t }} #<span x-text="orderId(order)"></span></p>
      <p class="mt-0.5 text-sm text-ritual-muted">
        <span x-text="formatDate(order.createdAt)"></span> ·
        <span x-text="itemCount(order)"></span> {{ 'account.items' | t }}
      </p>
    </div>
    <span class="rounded-full px-2.5 py-1 text-xs font-semibold" :class="statusTone(order.invoiceStatus)" x-text="statusLabel(order.invoiceStatus)"></span>
  </div>

  <div class="mt-4 flex items-center gap-2 overflow-hidden">
    <template x-for="(line, index) in (order.lineItems || []).slice(0, 5)" :key="index">
      <span class="size-12 shrink-0 overflow-hidden rounded-box border border-ritual-border bg-ritual-soft" :title="lineName(line)">
        <img class="size-full object-contain" :src="lineImage(line)" alt="" loading="lazy" x-show="lineImage(line)">
      </span>
    </template>
    <span class="text-sm text-ritual-muted" x-show="(order.lineItems || []).length > 5">+<span x-text="(order.lineItems || []).length - 5"></span></span>
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-ritual-border pt-3">
    <p class="text-sm">{{ 'checkout.total' | t }} <span class="ml-1 text-base font-semibold text-ritual-accent" x-text="$store.cart.formatMoney(order.netTotalAmount)"></span></p>
    <a class="inline-flex h-9 items-center gap-1.5 rounded-box bg-ritual-primary px-4 text-sm font-semibold text-ritual-on-primary hover:brightness-95" :href="'/track-order/' + encodeURIComponent(orderId(order))">
      {{ 'account.track_order' | t }} →
    </a>
  </div>
</article>
