{
  "$schema": "../../../packages/theme-engine/schemas/document.schema.json",
  "schemaVersion": 1,
  "prerender": "moderate",
  "globalSetting": {
    "colors": {
      "primary": "#91C846",
      "onPrimary": "#1A2E05",
      "accent": "#4D7C0F",
      "highlight": "#FFD43B",
      "background": "#ffffff",
      "page": "#ffffff",
      "soft": "#F3F6EE",
      "text": "#1F2937",
      "muted": "#6B7280",
      "border": "#E5E7EB",
      "sale": "#E8590C"
    },
    "fonts": {
      "heading": "Rubik",
      "body": "Rubik"
    },
    "typography": {
      "heading": {
        "family": "Rubik",
        "weight": "600"
      },
      "body": {
        "family": "Rubik",
        "size": "15px"
      },
      "caption": {
        "size": "13px",
        "letterSpacing": "0.01em"
      }
    },
    "siteStyle": {
      "layout": {
        "containerWidth": "full"
      },
      "buttons": {},
      "fields": {},
      "images": {}
    }
  },
  "chrome": {
    "top": [
      {
        "type": "announcement-bar",
        "props": {
          "text": "Free delivery on orders over ৳1500 · Delivered in 60 minutes"
        }
      },
      {
        "type": "header",
        "props": {
          "links": [
            {
              "label": "Great deals",
              "href": "/collections/all"
            },
            {
              "label": "Fresh produce",
              "href": "/collections/all"
            },
            {
              "label": "Daily essentials",
              "href": "/collections/all"
            }
          ]
        }
      }
    ],
    "bottom": [
      "footer"
    ]
  },
  "pages": {
    "home": [
      {
        "type": "hero-slider",
        "props": {
          "items": [
            {
              "image": {
                "fileAssetId": "6aec0938ee9db4c06a93885a",
                "key": "demo-grocery/unlistedFiles/charlotte-karlsen-DAih2b5MFcA-unsplash-d9ce9dc4-af9d-469c-979b-ebdf36f93713.jpg",
                "provider": "S3",
                "alt": null
              },
              "alt": "Fresh groceries",
              "href": "/collections/all"
            }
          ]
        }
      },
      "category-tiles",
      "feature-strip",
      {
        "type": "featured-collection",
        "props": {
          "heading": "Recommended for you",
          "layout": "row"
        }
      },
      "promo-banner",
      {
        "type": "featured-collection",
        "props": {
          "heading": "Daily essentials",
          "tinted": true,
          "limit": 10
        }
      }
    ],
    "collection": [
      "main-collection"
    ],
    "product": [
      "main-product",
      {
        "type": "product-grid",
        "props": {
          "heading": "You may also like",
          "limit": 5,
          "columns": 4
        }
      }
    ],
    "search": [
      "main-search"
    ],
    "checkout": [
      "main-checkout"
    ],
    "order-confirmation": [
      "main-order-confirmation"
    ],
    "account": [
      "main-account"
    ],
    "login": [
      "main-login"
    ],
    "orders": [
      "main-orders"
    ],
    "profile": [
      "main-profile"
    ],
    "cart": [
      "main-cart"
    ],
    "wishlist": [
      "main-wishlist"
    ],
    "track-order": [
      "main-track-order"
    ],
    "page": [
      "main-page"
    ],
    "blog": [
      "main-blog"
    ],
    "blog-post": [
      "main-article"
    ]
  }
}
