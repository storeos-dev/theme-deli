<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    {{ content_for_header }}
  </head>
  <body class="theme-deli min-h-screen" id="storeos-shop-{{ shop.uid }}">
    <script type="application/json" id="storeos-config">{"tenant":"{{ shop.uid }}","currency":"{{ shop.currency }}","apiBase":"{{ shop.api_url }}","cdnBase":"https://cdn.storeos.dev"}</script>
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:bg-ritual-bg focus:px-3 focus:py-2 focus:text-sm"
      href="#main"
    >{{ 'general.skip_to_content' | t }}</a>

    {{ content_for_top }}

    <main id="main">
      <section class="page-width mx-auto px-4 py-10 md:py-16">
        <div class="relative rounded-box bg-ritual-soft px-6 py-12 text-center md:px-12 md:py-16">
          {%- comment -%} Clip only the decoration, so the search suggestions can overflow the card {%- endcomment -%}
          <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-box" aria-hidden="true">
            <div class="absolute -left-16 -top-16 size-56 rounded-full bg-ritual-primary/25"></div>
            <div class="absolute -bottom-20 -right-10 size-64 rounded-full bg-ritual-highlight/40"></div>
          </div>

          <div class="relative mx-auto max-w-2xl">
            {%- comment -%} Empty basket illustration {%- endcomment -%}
            <svg class="mx-auto h-28 w-auto md:h-36" viewBox="0 0 200 140" fill="none" aria-hidden="true">
              <ellipse cx="100" cy="128" rx="70" ry="8" fill="var(--color-ritual-border)"/>
              <path d="M62 52 85 18M138 52 115 18" stroke="var(--color-ritual-accent)" stroke-width="6" stroke-linecap="round"/>
              <path d="M30 52h140l-14 66a10 10 0 0 1-9.8 8H53.8a10 10 0 0 1-9.8-8L30 52Z" fill="var(--color-ritual-primary)"/>
              <path d="M24 48h152a6 6 0 0 1 0 12H24a6 6 0 0 1 0-12Z" fill="var(--color-ritual-accent)"/>
              <circle cx="80" cy="92" r="5" fill="var(--color-ritual-on-primary)"/>
              <circle cx="120" cy="92" r="5" fill="var(--color-ritual-on-primary)"/>
              <path d="M86 112c8-7 20-7 28 0" stroke="var(--color-ritual-on-primary)" stroke-width="5" stroke-linecap="round"/>
            </svg>

            <p class="mt-6 font-heading text-6xl font-bold leading-none text-ritual-accent md:text-7xl">404</p>
            <h1 class="mt-3 font-heading text-2xl font-semibold md:text-3xl">{{ 'not_found.title' | t }}</h1>
            <p class="mx-auto mt-3 max-w-lg text-base text-ritual-muted">{{ 'not_found.body' | t }}</p>

            <div class="relative z-20 mx-auto mt-8 max-w-lg text-left">
              {% render 'search-box', id: 'deli-search-404', placeholder: 'Search your products' %}
            </div>

            <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
              <a class="inline-flex h-11 items-center gap-2 rounded-box bg-ritual-primary px-6 text-sm font-semibold text-ritual-on-primary hover:brightness-95" href="/">
                <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3.5 9 10 3.5 16.5 9v7.5h-4.5V12H8v4.5H3.5V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                {{ 'not_found.home' | t }}
              </a>
              <a class="inline-flex h-11 items-center gap-2 rounded-box border border-ritual-border bg-ritual-bg px-6 text-sm font-semibold hover:border-ritual-primary hover:text-ritual-accent" href="/collections/all">
                {{ 'not_found.shop_all' | t }} →
              </a>
            </div>
          </div>
        </div>

        {% if collections.size > 0 %}
          <div class="mt-10 text-center">
            <h2 class="deli-section-title">{{ 'not_found.browse' | t }}</h2>
            <ul class="mt-5 flex flex-wrap justify-center gap-2">
              {% for collection in collections limit: 12 %}
                <li>
                  <a class="inline-flex h-10 items-center rounded-box border border-ritual-border bg-ritual-bg px-4 text-sm font-medium hover:border-ritual-primary hover:bg-ritual-soft hover:text-ritual-accent" href="{{ collection.url }}">{{ collection.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </section>

      {{ content_for_layout }}
    </main>

    {{ content_for_bottom }}

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
