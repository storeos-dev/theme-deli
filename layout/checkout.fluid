<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    {{ content_for_header }}
  </head>
  {%- comment -%}
    Checkout has its own shell: no announcement bar, menu or footer, so nothing
    pulls the shopper away from placing the order.
  {%- endcomment -%}
  <body class="theme-deli flex min-h-screen flex-col bg-ritual-soft" id="storeos-shop-{{ shop.uid }}">
    <script type="application/json" id="storeos-config">{"tenant":"{{ shop.uid }}","currency":"{{ shop.currency }}","apiBase":"{{ shop.api_url }}","cdnBase":"https://cdn.storeos.dev"}</script>
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:bg-ritual-bg focus:px-3 focus:py-2 focus:text-sm"
      href="#main"
    >{{ 'general.skip_to_content' | t }}</a>

    <header class="border-b border-ritual-border bg-ritual-bg">
      <div class="page-width mx-auto flex h-16 items-center justify-between gap-4 px-4 md:h-20">
        <a class="inline-flex shrink-0 items-center" href="/" aria-label="{{ shop.name }}">
          {% if shop.logo %}
            <img class="h-8 w-auto md:h-10" src="{{ shop.logo | image_url }}" alt="{{ shop.name }}">
          {% else %}
            <img class="h-9 w-auto md:h-11" src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="56" height="41">
          {% endif %}
        </a>

        <p class="hidden items-center gap-2 text-sm font-medium text-ritual-muted sm:inline-flex">
          <svg class="size-4 text-ritual-accent" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 9V6.5a4 4 0 0 1 8 0V9m-9 0h10a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ 'checkout.secure' | t }}
        </p>

        <a class="inline-flex h-10 items-center gap-1.5 rounded-box px-3 text-sm font-medium hover:bg-ritual-soft hover:text-ritual-accent" href="/cart">
          <svg class="size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12 5 7 10l5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {{ 'checkout.back_to_bag' | t }}
        </a>
      </div>
    </header>

    <main id="main" class="flex-1">
      {{ content_for_layout }}
    </main>

    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
